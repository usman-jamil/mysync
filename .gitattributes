# Keep line endings identical on every OS so EnforceCodeStyleInBuild (IDE0055) behaves the
# same on the ubuntu, windows and macos CI runners. .editorconfig asks for CRLF in C#.
* text=auto
*.cs text eol=crlf
*.sh text eol=lf
*.gz binary
# Signed fixtures and keys: any line-ending change would break the signatures.
tools/release/testdata/** binary
*.sig binary
*.pem text eol=lf
install.sh text eol=lf

# Served as-is from the static website: the same bytes on every OS.
libs/mysync/site-assets/Root/* text eol=lf
