<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>MySync.SiteAssets</RootNamespace>
    <RepoRoot>$([MSBuild]::GetDirectoryNameOfFileAbove('$(MSBuildProjectDirectory)', 'mysync.slnx'))/</RepoRoot>
    <!-- `nx build mysync-site` writes here; this project embeds it (CLAUDE.md, Publishing). -->
    <MySyncSiteDist>$(RepoRoot)dist/apps/mysync-site/</MySyncSiteDist>
    <MySyncSitePlaceholder>$(IntermediateOutputPath)site-placeholder/</MySyncSitePlaceholder>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\application\MySync.Application.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="MySync.SiteAssets.UnitTests" />
  </ItemGroup>

  <!-- The CLI-owned files for the root of the static website ($web/index.html, 404.html, robots.txt). -->
  <ItemGroup>
    <EmbeddedResource Include="Root/*" LogicalName="root/%(Filename)%(Extension)" />
  </ItemGroup>

  <!--
    Embeds the site build at build time (not at evaluation, so a site built moments earlier by
    `nx build mysync` is picked up). Resource names use forward slashes on every OS.
    Missing build: Release fails; Debug warns and embeds a placeholder page, which `mysync publish` refuses.
  -->
  <Target Name="EmbedMySyncSite" BeforeTargets="BeforeBuild">
    <PropertyGroup>
      <MySyncSiteBuilt Condition="Exists('$(MySyncSiteDist)index.html')">true</MySyncSiteBuilt>
    </PropertyGroup>

    <Error Condition="'$(MySyncSiteBuilt)' != 'true' And '$(Configuration)' == 'Release'"
           Code="MYSYNC001"
           Text="mysync-site assets not found — run &quot;nx build mysync&quot; (or &quot;nx build mysync-site&quot; first). Looked in $(MySyncSiteDist)." />

    <Warning Condition="'$(MySyncSiteBuilt)' != 'true'"
             Code="MYSYNC002"
             Text="mysync-site assets not found in $(MySyncSiteDist); embedding a placeholder page. This build can't run `mysync publish`. Run &quot;nx build mysync-site&quot; to embed the real site." />

    <ItemGroup Condition="'$(MySyncSiteBuilt)' == 'true'">
      <MySyncSiteFile Include="$(MySyncSiteDist)**/*" />
      <EmbeddedResource Include="@(MySyncSiteFile)"
                        LogicalName="site/$([System.String]::Copy('%(RecursiveDir)').Replace('\','/'))%(Filename)%(Extension)" />
    </ItemGroup>

    <WriteLinesToFile Condition="'$(MySyncSiteBuilt)' != 'true'"
                      File="$(MySyncSitePlaceholder)index.html"
                      Overwrite="true"
                      WriteOnlyWhenDifferent="true"
                      Lines="&lt;!doctype html&gt;&lt;html lang=&quot;en&quot;&gt;&lt;head&gt;&lt;meta charset=&quot;utf-8&quot;&gt;&lt;title&gt;mysync-site not built&lt;/title&gt;&lt;/head&gt;&lt;body&gt;&lt;p&gt;The mysync-site assets weren't built into this binary. Run nx build mysync-site, then build mysync again.&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;" />
    <WriteLinesToFile Condition="'$(MySyncSiteBuilt)' != 'true'"
                      File="$(MySyncSitePlaceholder)placeholder.txt"
                      Overwrite="true"
                      WriteOnlyWhenDifferent="true"
                      Lines="Built without mysync-site: mysync publish refuses to run." />
    <ItemGroup Condition="'$(MySyncSiteBuilt)' != 'true'">
      <EmbeddedResource Include="$(MySyncSitePlaceholder)index.html" LogicalName="site/index.html" />
      <EmbeddedResource Include="$(MySyncSitePlaceholder)placeholder.txt" LogicalName="mysync-site-placeholder" />
    </ItemGroup>
  </Target>

</Project>
