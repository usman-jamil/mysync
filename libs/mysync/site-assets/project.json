{
  "name": "mysync-site-assets",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "projectType": "library",
  "sourceRoot": "libs/mysync/site-assets",
  "tags": [
    "stack:mysync",
    "type:lib"
  ],
  "implicitDependencies": ["mysync-site"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "dependsOn": [{ "projects": ["mysync-site"], "target": "build" }],
      "inputs": ["default", "{workspaceRoot}/dist/apps/mysync-site/**/*"],
      "options": {
        "command": "dotnet build libs/mysync/site-assets/MySync.SiteAssets.csproj -c Release"
      }
    }
  }
}
