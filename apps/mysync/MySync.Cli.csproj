<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>MySync.Cli</RootNamespace>
    <!-- Renaming the tool? See the note at the top of CLAUDE.md. -->
    <AssemblyName>mysync</AssemblyName>
    <!-- Overridden by the release workflow with -p:Version=<tag>. -->
  </PropertyGroup>

  <!--
    Set by the release workflow (and the update end-to-end test), never by hand: the repository this
    binary updates from and the public key its releases must be signed with. A fork's workflow sets
    its own, so its users update from the fork. Unset (a local build): the defaults in the Domain.
  -->
  <ItemGroup Condition="'$(MySyncReleasePublicKey)' != ''">
    <AssemblyMetadata Include="MySyncReleasePublicKey" Value="$(MySyncReleasePublicKey)" />
  </ItemGroup>
  <ItemGroup Condition="'$(MySyncReleaseRepository)' != ''">
    <AssemblyMetadata Include="MySyncReleaseRepository" Value="$(MySyncReleaseRepository)" />
  </ItemGroup>

  <ItemGroup>
    <Content Update="project.json">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ConsoleAppFramework">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="ConsoleAppFramework.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Serilog" />
    <PackageReference Include="Serilog.Extensions.Hosting" />
    <PackageReference Include="Serilog.Extensions.Logging" />
    <PackageReference Include="Serilog.Sinks.Console" />
    <PackageReference Include="Spectre.Console" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\libs\mysync\application\MySync.Application.csproj" />
    <ProjectReference Include="..\..\libs\mysync\infrastructure\MySync.Infrastructure.csproj" />
    <ProjectReference Include="..\..\libs\mysync\storage-azure\MySync.Storage.Azure.csproj" />
    <ProjectReference Include="..\..\libs\mysync\updates-github\MySync.Updates.GitHub.csproj" />
  </ItemGroup>

</Project>
