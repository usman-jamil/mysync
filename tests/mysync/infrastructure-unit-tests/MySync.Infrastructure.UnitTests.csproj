<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>MySync.Infrastructure.UnitTests</RootNamespace>
    <OutputType>exe</OutputType>
    <TestingPlatformDotnetTestSupport>true</TestingPlatformDotnetTestSupport>
    <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Ignore/gitignore-cases.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="JsonSchema.Net" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Shouldly" />
    <PackageReference Include="xunit.v3.mtp-v2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\libs\mysync\infrastructure\MySync.Infrastructure.csproj" />
    <ProjectReference Include="..\..\..\libs\mysync\updates-github\MySync.Updates.GitHub.csproj" />
    <ProjectReference Include="..\testing\MySync.Testing.csproj" />
  </ItemGroup>

  <!-- mysync clone's runner lives in the composition root (the CLI); linked in, so DiskCloneTests run the real one. -->
  <ItemGroup>
    <Compile Include="..\..\..\apps\mysync\Hosting\FolderCloneRunner.cs" Link="Linked\FolderCloneRunner.cs" />
  </ItemGroup>

</Project>
