{
  "name": "mysync-site-assets-unit-tests",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "projectType": "library",
  "sourceRoot": "tests/mysync/site-assets-unit-tests",
  "tags": [
    "stack:mysync",
    "type:unit-test",
    "requires:site-build"
  ],
  "implicitDependencies": ["mysync-site-assets"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "dependsOn": [{ "projects": ["mysync-site"], "target": "build" }],
      "options": {
        "command": "dotnet build tests/mysync/site-assets-unit-tests/MySync.SiteAssets.UnitTests.csproj -c Release"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "dependsOn": [{ "projects": ["mysync-site"], "target": "build" }],
      "options": {
        "command": "dotnet test --project tests/mysync/site-assets-unit-tests/MySync.SiteAssets.UnitTests.csproj -c Release"
      }
    }
  }
}
