<Project Sdk="Microsoft.NET.Sdk">

  <!-- Shared fakes and builders for the mysync test projects. Not a test project itself. -->
  <PropertyGroup>
    <RootNamespace>MySync.Testing</RootNamespace>
    <IsPackable>false</IsPackable>
    <IsTestProject>false</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Testcontainers.Azurite" />
    <!-- Sets up Azurite's publishing accounts (static website); test code only, never a library's. -->
    <PackageReference Include="Azure.Storage.Blobs" />
    <!-- The abstract contract suites carry [Fact]s and assertions; the runner stays in the test projects. -->
    <PackageReference Include="Shouldly" />
    <PackageReference Include="xunit.v3.extensibility.core" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\libs\mysync\application\MySync.Application.csproj" />
    <ProjectReference Include="..\..\..\libs\mysync\tui\MySync.Tui.csproj" />
  </ItemGroup>

</Project>
