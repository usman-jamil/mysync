<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>MySync.EndToEndTests</RootNamespace>
    <OutputType>exe</OutputType>
    <TestingPlatformDotnetTestSupport>true</TestingPlatformDotnetTestSupport>
    <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Shouldly" />
    <PackageReference Include="Testcontainers.Azurite" />
    <PackageReference Include="xunit.v3.mtp-v2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\libs\mysync\application\MySync.Application.csproj" />
    <ProjectReference Include="..\..\..\libs\mysync\infrastructure\MySync.Infrastructure.csproj" />
    <ProjectReference Include="..\..\..\libs\mysync\storage-azure\MySync.Storage.Azure.csproj" />
    <ProjectReference Include="..\..\..\libs\mysync\updates-github\MySync.Updates.GitHub.csproj" />
    <ProjectReference Include="..\..\..\libs\mysync\site-assets\MySync.SiteAssets.csproj" />
    <ProjectReference Include="..\testing\MySync.Testing.csproj" />
    <!-- Not referenced as a library: the CLI tests run the built mysync as a process, so it only has to be built first. -->
    <ProjectReference Include="..\..\..\apps\mysync\MySync.Cli.csproj" ReferenceOutputAssembly="false" SkipGetTargetFrameworkProperties="true" />
  </ItemGroup>

  <!-- Pure, BCL-only CLI helpers, unit-tested here: the CLI assembly itself is only run as a process. -->
  <ItemGroup>
    <Compile Include="..\..\..\apps\mysync\Rendering\ShellQuote.cs" Link="Cli\Linked\ShellQuote.cs" />
    <Compile Include="..\..\..\apps\mysync\Rendering\TerminalText.cs" Link="Cli\Linked\TerminalText.cs" />
    <Compile Include="..\..\..\apps\mysync\Hosting\SwitchableLogSink.cs" Link="Cli\Linked\SwitchableLogSink.cs" />
  </ItemGroup>

</Project>
